{
	"name": "svelte-sveltekit-template",
	"version": "0.1.0",
	"private": true,
	"description": "Minimal SvelteKit template with Skeleton, TypeScript, linting, and Vitest coverage.",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage",
		"validate": "npm run check && npm run lint && npm run test:coverage"
	},
	"devDependencies": {
		"@skeletonlabs/skeleton": "2.7.0",
		"@skeletonlabs/tw-plugin": "0.3.1",
		"@sveltejs/adapter-auto": "3.2.0",
		"@sveltejs/kit": "2.37.0",
		"@sveltejs/vite-plugin-svelte": "3.0.0",
		"@testing-library/svelte": "^4.2.3",
		"@types/node": "20.11.0",
		"@typescript-eslint/eslint-plugin": "^6.0.0",
		"@typescript-eslint/parser": "^6.0.0",
		"@vitest/coverage-v8": "^1.6.0",
		"autoprefixer": "10.4.16",
		"eslint": "^8.56.0",
		"eslint-config-prettier": "^9.1.0",
		"eslint-plugin-svelte": "^2.35.1",
		"jsdom": "^24.1.0",
		"postcss": "8.4.33",
		"prettier": "^3.1.1",
		"prettier-plugin-svelte": "^3.1.2",
		"svelte": "4.2.7",
		"svelte-check": "3.6.0",
		"svelte-eslint-parser": "^0.33.1",
		"tailwindcss": "3.4.1",
		"tslib": "^2.4.1",
		"typescript": "^5.0.0",
		"vite": "5.0.3",
		"vitest": "^1.6.0"
	}
}
