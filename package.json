{
	"name": "svelte-sveltekit-template",
	"version": "0.1.0",
	"private": true,
	"description": "Minimal SvelteKit template with Skeleton, TypeScript, linting, and Vitest coverage.",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test": "npm run test:unit && npm run test:accessibility",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage",
		"validate": "npm run check && npm run lint && npm run test:coverage && npm run test:accessibility",
		"test:unit": "vitest run",
		"test:accessibility": "node scripts/check-accessibility.mjs",
		"test:e2e": "playwright test",
		"check:build": "node scripts/check-build.mjs",
		"validate:release": "npm run validate && npm run build && npm run test:e2e && npm run check:build",
		"test:build-matrix": "node scripts/check-build-matrix.mjs"
	},
	"devDependencies": {
		"@playwright/test": "^1.65.0",
		"@skeletonlabs/skeleton": "2.11.0",
		"@skeletonlabs/tw-plugin": "0.3.1",
		"@sparticuz/chromium": "^153.0.0",
		"@sveltejs/adapter-netlify": "^7.0.1",
		"@sveltejs/kit": "3.1.1",
		"@sveltejs/vite-plugin-svelte": "^7.0.0",
		"@testing-library/svelte": "^5.0.0",
		"@types/node": "^22.12.0",
		"@typescript-eslint/eslint-plugin": "^8.0.0",
		"@typescript-eslint/parser": "^8.0.0",
		"@vitest/coverage-v8": "4.1.12",
		"autoprefixer": "10.4.16",
		"esbuild": "^0.28.2",
		"eslint": "^8.56.0",
		"eslint-config-prettier": "^9.1.0",
		"eslint-plugin-svelte": "^2.35.1",
		"jsdom": "^24.1.0",
		"pa11y": "^10.0.0",
		"postcss": "8.5.32",
		"prettier": "^3.1.1",
		"prettier-plugin-svelte": "^3.1.2",
		"puppeteer-core": "^25.16.0",
		"svelte": "5.57.3",
		"svelte-check": "^4.0.0",
		"svelte-eslint-parser": "^0.43.0",
		"tailwindcss": "3.4.1",
		"tslib": "^2.4.1",
		"typescript": "^6.0.0",
		"vite": "^8.0.12",
		"vitest": "4.1.12"
	},
	"engines": {
		"node": ">=22.17.0"
	},
	"imports": {
		"#lib": "./src/lib/index.ts",
		"#lib/*": "./src/lib/*",
		"#telemetry": "./src/lib/observability/disabled.ts"
	},
	"overrides": {
		"@typescript-eslint/typescript-estree": {
			"minimatch": "^11.0.1"
		}
	},
	"dependencies": {
		"@sentry/sveltekit": "^11.11.0"
	}
}
