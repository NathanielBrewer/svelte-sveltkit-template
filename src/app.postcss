@tailwind base;
@tailwind components;
@tailwind utilities;
@tailwind variants;

@layer base {
	html {
		@apply bg-surface-50;
	}

	body {
		@apply min-h-screen bg-surface-50 text-surface-900 antialiased;
	}

	:focus-visible {
		@apply outline outline-2 outline-offset-2 outline-primary-500;
	}
}

/* Keep the template's action variants readable at normal text sizes. */
@layer utilities {
	.variant-filled-primary {
		@apply bg-primary-800 text-white;
	}

	.variant-filled-primary:hover {
		@apply bg-primary-900 text-white;
	}

	.variant-soft-secondary {
		@apply text-secondary-800;
	}

	.variant-soft-success {
		@apply text-success-800;
	}

	.variant-soft-warning {
		@apply text-warning-900;
	}
}

@layer components {
	.content-panel {
		@apply border border-surface-300 bg-surface-100 p-6;
		border-radius: var(--theme-rounded-container);
		background: var(--template-panel-background, rgb(var(--color-surface-100)));
	}
	[id] {
		scroll-margin-top: 6rem;
	}
	@media (prefers-reduced-motion: reduce) {
		*,
		*::before,
		*::after {
			scroll-behavior: auto !important;
			animation-duration: 0.01ms !important;
			transition-duration: 0.01ms !important;
		}
	}
}

@layer utilities {
	.anchor {
		@apply text-primary-800;
	}
	.anchor:hover {
		@apply text-primary-900;
		filter: none;
	}
}
