{
	"extends": "$app/tsconfig",
	"include": ["src", "*"],
	"exclude": ["node_modules", ".svelte-kit", "build", "coverage"],
	"compilerOptions": {
		"allowJs": true,
		"checkJs": false,
		"esModuleInterop": true,
		"forceConsistentCasingInFileNames": true,
		"moduleResolution": "bundler",
		"resolveJsonModule": true,
		"skipLibCheck": true,
		"sourceMap": true,
		"strict": true
	}
}
