# Optional build-time Sentry DSN. Empty means the Sentry SDK is excluded from the build.
# DSNs are public ingestion addresses. Never put an auth token here.
PUBLIC_SENTRY_DSN=

# Private, runtime contact configuration. Leave empty to disable delivery (HTTP 503).
# Enable Netlify form detection and notifications before using this in production.
CONTACT_PROVIDER=
# HTTPS site origin; defaults to Netlify's URL, then DEPLOY_URL when available.
NETLIFY_FORMS_ENDPOINT=
